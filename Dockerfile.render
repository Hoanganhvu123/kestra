# Dockerfile for Render deployment
# Kế thừa từ Kestra official image
FROM kestra/kestra:latest

# Tạo wrapper script để map PORT từ Render → KESTRA_SERVER_PORT
RUN echo '#!/bin/sh' > /app/start-kestra.sh && \
    echo '# Map PORT env var từ Render sang KESTRA_SERVER_PORT' >> /app/start-kestra.sh && \
    echo 'export KESTRA_SERVER_PORT=${PORT:-8080}' >> /app/start-kestra.sh && \
    echo '' >> /app/start-kestra.sh && \
    echo '# Start Kestra server standalone' >> /app/start-kestra.sh && \
    echo 'exec /app/kestra server standalone' >> /app/start-kestra.sh && \
    chmod +x /app/start-kestra.sh

# Set entrypoint
ENTRYPOINT ["/app/start-kestra.sh"]
